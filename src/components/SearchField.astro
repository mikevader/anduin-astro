---
/** Presentation only. Wiring it to an index is still open. */
interface Props { value?: string; }
const { value = '' } = Astro.props;
---
<form
  class="breakout"
  role="search"
  action="/search/"
  method="get"
  style="display: flex; align-items: center; gap: 14px; height: 58px; padding: 0 20px; background: var(--panel); border: 1px solid var(--rule-strong); border-radius: var(--radius)"
>
  <label class="label" for="q" style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%)">Search posts</label>
  <span style="color: var(--muted); display: flex">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="5.5" /><path d="M 12.6 12.6 L 17 17" />
    </svg>
  </span>
  <input
    id="q" name="q" type="search" value={value} autocomplete="off"
    style="flex-grow: 1; border: none; background: none; outline: none; font-family: var(--font-mono); font-size: 16px; color: var(--ink)"
  />
</form>
