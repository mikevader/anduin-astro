---
import { footer, masthead } from '../lib/terrain.ts';

/**
 * The contour ground. Composed, not traced.
 *
 * The lines are contoured at build time from a height field in
 * `src/lib/terrain.ts`, which is where the landforms are composed and
 * described. What this component adds is how they are drawn.
 *
 * The masthead reads west to east: a massif with a spur, the plain, the river,
 * hill country rising to a range with a vale cutting into it. The ground
 * between Minas Tirith and Minas Morgul; nothing is lifted from Tolkien's map
 * and no place names appear.
 *
 * Every fifth contour is an index contour, drawn heavier — the convention
 * that makes a set of lines read as a map at a glance.
 *
 * The narrow variant is the same world at a smaller scale, not a crop or a
 * scaled copy: the stroke stays 1px and the contour interval doubles.
 *
 * The lines live in `/terrain/<variant>-<size>.svg` and are pulled in with
 * `<use>`, so they are fetched once and cached rather than inlined into every
 * page. The rivers are a few hundred bytes and stay inline.
 *
 * Only the masthead variant draws a river. The footer's is drawn by a
 * continuous <River> running the height of the footer, so it joins the article
 * river without a seam; the footer contours are cut where that river runs.
 */
interface Props {
  /** `masthead` carries the river; `footer` is the lower plain. */
  variant?: 'masthead' | 'footer';
}
const { variant = 'masthead' } = Astro.props;
const art = variant === 'masthead' ? masthead() : footer();
const opacity = variant === 'masthead' ? { lines: 0.15, index: 0.26 } : { lines: 0.11, index: 0.19 };
const stroke = { wide: { bank: 7, river: 2.2 }, narrow: { bank: 6, river: 2 } };
---
<div class={`terrain terrain--${variant}`}>
  {(['wide', 'narrow'] as const).map((size) => {
    const a = art[size];
    const src = `/terrain/${variant}-${size}.svg?v=${a.version}`;
    return (
      <svg class={`terrain__${size}`} width={a.width} height={a.height} viewBox={`0 0 ${a.width} ${a.height}`} fill="none" aria-hidden="true">
        <g stroke="var(--ink)" stroke-linejoin="round">
          <use href={`${src}#lines`} stroke-width="1" stroke-opacity={opacity.lines} />
          <use href={`${src}#index`} stroke-width="1.3" stroke-opacity={opacity.index} />
        </g>
        {a.stream && <path d={a.stream} stroke="var(--river)" stroke-width="1.2" stroke-opacity="0.75" stroke-linecap="round" />}
        {a.river && <>
          <path d={a.river} stroke="var(--bank)" stroke-width={stroke[size].bank} stroke-linecap="round" />
          <path d={a.river} stroke="var(--river)" stroke-width={stroke[size].river} stroke-linecap="round" />
        </>}
      </svg>
    );
  })}
</div>
