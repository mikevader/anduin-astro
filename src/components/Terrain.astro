        <path d="M 1072 8 C 1096 8, 1110 44, 1108 88 C 1106 134, 1092 164, 1068 162 C 1046 160, 1034 122, 1038 80 C 1042 36, 1052 8, 1072 8 Z" />
        <path d="M 1068 -28 C 1104 -28, 1126 28, 1124 90 C 1122 156, 1100 198, 1064 196 C 1030 194, 1012 136, 1018 74 C 1024 12, 1038 -28, 1068 -28 Z" />
