---
/**
 * The contour ground. Drawn, not traced.
 *
 * Read west to east: a massif with a spur running off it, the plain, the river
 * crossing, rising ground, then a range running north-south off both edges with
 * a valley cutting west into it — contours pointing upstream, which is how a
 * map draws one. Same profile as the ground between Minas Tirith and Minas
 * Morgul; nothing is lifted from Tolkien's map and no place names appear.
 *
 * The narrow variant is redrawn rather than scaled: the massif moves right so
 * the river still exits low and left, on the axis the article river runs down.
 *
 * Only the masthead variant carries a river. The footer's is drawn by a
 * continuous <River> running the height of the footer, so it joins the
 * article river without a seam.
 */
interface Props {
  /** `masthead` carries the river; `footer` is the lower plain. */
  variant?: 'masthead' | 'footer';
}
const { variant = 'masthead' } = Astro.props;
const opacity = variant === 'masthead' ? 0.115 : 0.09;
---

