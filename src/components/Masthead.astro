---
import Terrain from './Terrain.astro';
import Icon from './Icon.astro';

interface Props { current?: 'blog' | 'projects' | 'search'; }
const { current } = Astro.props;
---
<header class="masthead">
  <div class="masthead__bar wrap">
    <a class="logo" href="/">anduin<span class="logo__tld">.ch</span></a>
    <nav class="nav">
      <a class="nav__item" href="/" aria-current={current === 'blog' ? 'page' : undefined}>blog</a>
      <a class="nav__item" href="/projects/" aria-current={current === 'projects' ? 'page' : undefined}>projects</a>
      <a class="nav__item" href="/search/" aria-current={current === 'search' ? 'page' : undefined}>
        <Icon name="search" /><span>search</span>
      </a>
    </nav>
  </div>
  <Terrain variant="masthead" />
</header>
